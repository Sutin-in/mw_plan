# Copy to .env (git-ignored) or run tools/dev/setup_local_db.py, which writes .env for you.
# Never commit real passwords or secrets.

# Development database
PPR_DATABASE_URL=postgresql+psycopg://ppr_app:CHANGE_ME@localhost:5432/ppr_dev

# Test database - name MUST end with _test (tests drop and recreate its schema)
PPR_TEST_DATABASE_URL=postgresql+psycopg://ppr_app:CHANGE_ME@localhost:5432/ppr_test

# HMAC key for application session tokens (at least 32 random characters)
PPR_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Session lifetime in minutes
PPR_SESSION_TTL_MINUTES=480

# ---- HOSxP connection (see docs/HOSXP_CONNECTION.md)
# mock = built-in sample data (default); sql = real HOSxP through read-only queries
PPR_HOSXP_MODE=mock
# READ-ONLY HOSxP database account (MySQL/MariaDB or PostgreSQL); needed for mode=sql
# PPR_HOSXP_DATABASE_URL=postgresql+psycopg://ppr_readonly:CHANGE_ME@hosxp-db-host:5432/hosxp_db_name
# (MySQL/MariaDB: mysql+pymysql://ppr_readonly:CHANGE_ME@hosxp-db-host:3306/hosxp_db_name)
# Optional (D-41): HOSxP user accounts on ANOTHER server - read-only account used only by the
# sign-in queries get_login_user / get_user_profile; leave unset when it is the same database
# PPR_HOSXP_AUTH_DATABASE_URL=postgresql+psycopg://ppr_readonly:CHANGE_ME@hosxp-login-host:5432/login_db_name
# Site query file (default: hosxp_queries.toml in the repository root, git-ignored)
# PPR_HOSXP_QUERIES=C:\Project_AI\Plan_Claude\hosxp_queries.toml

# Optional, tests only: a MySQL/MariaDB *_test database for the SQL adapter tests
# PPR_TEST_HOSXP_MYSQL_URL=mysql+pymysql://user:CHANGE_ME@localhost:3306/mockhx_test

# ---- Production (Wave 10A, see docs/DEPLOY_PRODUCTION.md) - leave unset on development machines
# PPR_PROFILE=production
# Runtime account (least privilege): the application's PPR_DATABASE_URL above uses it, e.g.
#   PPR_DATABASE_URL=postgresql+psycopg://ppr_runtime:CHANGE_ME@localhost:5432/ppr
# Schema owner, used only by "python -m ppr.cli migrate" and "backup"
# PPR_MIGRATION_DATABASE_URL=postgresql+psycopg://ppr_owner:CHANGE_ME@localhost:5432/ppr
# Role that "migrate" grants the runtime rights to
# PPR_RUNTIME_ROLE=ppr_runtime
# User interface behind the hospital's HTTPS reverse proxy
# PPR_UI_SECURE_COOKIES=1
# PPR_UI_TRUST_PROXY=loopback
# Ports (defaults 8000 / 3000); the API listens on 127.0.0.1 only
# PPR_API_PORT=8000
# PPR_API_URL=http://127.0.0.1:8000
# PPR_UI_PORT=3000
# PPR_UI_HOST=127.0.0.1
# Logs and supervisor state (defaults: logs\ and run\ in the repository folder)
# PPR_LOG_DIR=D:\ppr\logs
# PPR_LOG_KEEP_DAYS=90
# PostgreSQL client tools for backup/restore when not on PATH
# PPR_PG_BIN=C:\Program Files\PostgreSQL\16\bin
